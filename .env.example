# --- Server ---
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# --- Database (Supabase/Postgres via Prisma — the only datastore; MongoDB has
#     been fully removed). Get these from your Supabase project:
#     Project Settings -> Database -> Connection string.
#     DATABASE_URL: the "Transaction" pooler connection string (port 6543, for
#       the app's normal runtime queries through PgBouncer).
#     DIRECT_URL: the "Session"/direct connection string (port 5432, required
#       by `prisma migrate` because migrations can't run through the pooler). ---
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# --- Auth ---
JWT_SECRET=change-me-dev-secret-access
JWT_REFRESH_SECRET=change-me-dev-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- AI Provider ---
# Which provider the AI abstraction layer calls. "local" runs a deterministic,
# rule-based provider (no external API, no fabricated data) so the app is fully
# functional without a key. Set to "anthropic" and supply AI_API_KEY to enable
# live LLM chat/content-generation.
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Email integrations (Section 24) ---
EMAIL_PROVIDER=development
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# --- WhatsApp integration (Section 26) ---
WHATSAPP_PROVIDER=development
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Telephony integration (Section 27) ---
TELEPHONY_PROVIDER=development
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
